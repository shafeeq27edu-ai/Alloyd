# Origin of the Alloyd API, including the /api prefix.
# The browser calls this URL directly, so it must be reachable from the
# browser and must be listed in the backend's ALLOWED_ORIGINS.
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api"

# Comma-separated extra hostnames allowed to load the Next.js dev server
# (development only). Needed when testing sibling subdomains locally,
# for example "app.lvh.me".
NEXT_ALLOWED_DEV_ORIGINS=""
