PROJECT_NAME="Alloyd Phase 1"
# Either a single URL or the DB_* parts below (the URL wins when both are set).
DATABASE_URL="postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
# DB_HOST=
# DB_PORT=5432
# DB_USER=
# DB_PASSWORD=
# DB_NAME=alloyd
SECRET_KEY="replace_with_strong_secret_key"
ENCRYPTION_KEY="replace_with_32_byte_url_safe_base64_string="
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional provider timeouts (seconds)
PROVIDER_TIMEOUT_SECONDS=60
PROVIDER_FIRST_CHUNK_TIMEOUT_SECONDS=20

# Defaults to false. Set true only for local HTTP development so cookies
# are not marked Secure.
DEBUG=false
# Comma-separated IPs/CIDRs allowed to set X-Forwarded-For (reverse proxy only).
TRUSTED_PROXIES=
# Maximum accepted request body size in bytes.
MAX_REQUEST_BYTES=1000000
# Character budget for conversation history sent to a provider. Older
# messages are dropped (with a notice) when the history exceeds it.
HISTORY_MAX_CHARS=24000

# Comma-separated browser origins allowed to call the API with cookies.
# Exact origins only (scheme + host + port); wildcards are rejected.
# For sibling subdomains this is usually the frontend host, e.g.
# https://app.example.com
ALLOWED_ORIGINS="http://localhost:3000"

# Cookie scope. Set a parent domain so the frontend and API share the auth
# cookie across sibling subdomains, e.g. ".example.com". Leave empty for
# single-host development. COOKIE_SECURE defaults to the inverse of DEBUG;
# set true in production (HTTPS).
COOKIE_DOMAIN=
COOKIE_SECURE=

# Structured logging: json (default) or text. Message content and keys are
# never logged; request logs contain method, path, status, and duration only.
LOG_LEVEL=INFO
LOG_FORMAT=json

# Startup and readiness checks.
DB_CONNECT_TIMEOUT_SECONDS=5
STARTUP_DB_CHECK_RETRIES=10
STARTUP_DB_CHECK_DELAY_SECONDS=2

# Set true when DATABASE_URL points at a PgBouncer transaction pooler
# (for example Supabase port 6543). It is auto-detected for
# pooler.supabase.com and :6543 URLs; set explicitly if your pooler uses
# a different hostname.
DB_DISABLE_PREPARED_STATEMENTS=false
